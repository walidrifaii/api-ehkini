APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local dev: use your artisan serve URL so generated links match (Swagger also defaults to "/").
APP_URL=http://127.0.0.1:8000
# Production (Easypanel): exact public API URL, https, no trailing slash.
# Wrong APP_URL breaks image links returned by the API.
# APP_URL=https://your-api.easypanel.host

# API locale (default en). Per request: X-App-Language or ?lang= (not saved on users table).
# Mobile UI strings: add language in DB (languages + translation_values), then GET /api/v2/translations/{code}
# APP_LOCALE=en
# APP_LOCALES=en,ar
# Optional: extra codes that have lang/{code}/api.php for server error messages (DB languages work without listing here)

# --- Remote upload endpoint (default media disk) ---
# Uploads images/videos via POST multipart "file" to UPLOAD_ENDPOINT (upload.php),
# authenticated with UPLOAD_API_TOKEN. The endpoint returns a relative path like
# "image/xxx.jpg" and serves it from the pluralized folder, e.g.
# https://st79068.ispot.cc/images/xxx.jpg. UPLOAD_PUBLIC_BASE is the host root.
MEDIA_DISK=remote
UPLOAD_ENDPOINT=https://st79068.ispot.cc/upload.php
UPLOAD_API_TOKEN=YourSuperSecretToken2026!@#
UPLOAD_PUBLIC_BASE=https://st79068.ispot.cc

# --- ImageKit (legacy alternative; set MEDIA_DISK=imagekit to use) ---
# https://imagekit.io/dashboard/developer/api-keys
# MEDIA_DISK=imagekit
# IMAGEKIT_PUBLIC_KEY=your_public_key
# IMAGEKIT_PRIVATE_KEY=your_private_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_FOLDER_PREFIX=ehkini
# MEDIA_URL=https://ik.imagekit.io/your_imagekit_id
#
# Save full https URLs in DB (users.profile_image, posts.image, stories.media, gifts.image)
# MEDIA_STORE_FULL_URL_IN_DB=true
# One-time backfill on amcserver: MEDIA_LEGACY_BASE_URL=https://amcserver.com/app/taaruf/storage/app/public
# Or if files are under /public/: https://amcserver.com/app/taaruf/public

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.amcserver.com
MAIL_PORT=587
MAIL_USERNAME=teamsdeveloper@amcserver.com
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=teamsdeveloper@amcserver.com
MAIL_FROM_NAME="Taaruf"
SUPPORT_ADMIN_EMAIL=teamsdeveloper@amcserver.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Swagger / OpenAPI (API v2 docs at /api/documentation)
L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_USE_ABSOLUTE_PATH=false
# Set true when APP_URL is correct https:// in production (or rely on FORCE_HTTPS)
FORCE_HTTPS=false

# --- Firebase Cloud Messaging (incoming calls, chat, gifts) ---
# Local .env OR Easypanel Environment panel (NOT in git).
#
# FCM_PROJECT_ID=taaruf-f15c3
#
# Option A — JSON in .env (local dev): generate from your Firebase download:
#   php artisan fcm:env-json C:\path\to\taaruf-f15c3-firebase-adminsdk-xxxxx.json
# Copy the two lines it prints. Use single quotes around the JSON (command adds them).
# FCM_CREDENTIALS_JSON='{"type":"service_account","project_id":"taaruf-f15c3",...}'
#
# Option B — base64 (Easypanel, long values): base64 -w0 serviceAccount.json
# FCM_CREDENTIALS_BASE64=
#
# Option C — file on disk (Docker): upload to storage/app/firebase-service-account.json
# FCM_CREDENTIALS_FILE=/app/storage/app/firebase-service-account.json
#
# After saving: php artisan config:clear && php artisan fcm:check

# --- OTP: WhatsApp = node | Lebanon SMS = UnoSMS | other SMS = Message Central ---
# Optional dedicated secret. If empty, Laravel APP_KEY is used automatically.
OTP_PEPPER=
# OTP_TTL_SECONDS=300
# OTP_CHANNEL=auto
#
# WhatsApp OTP → your WhatsApp node (when user picks WhatsApp in app)
# OTP_WHATSAPP_NODE_ENABLED=true
# WHATSAPP_NODE_URL=https://amctag-whats.38f0fz.easypanel.host
# WHATSAPP_NODE_TOKEN=
# WHATSAPP_NODE_CLIENT_ID=
# WHATSAPP_NODE_DELIVERY=otp
# WHATSAPP_NODE_TIMEOUT=35
# WHATSAPP_NODE_CONNECT_TIMEOUT=5
# WHATSAPP_NODE_PHONE_FORMAT=DIGITS
#
# SMS OTP → Message Central VerifyNow (flowType=SMS). WhatsApp OTP → node above.
# OTP_MESSAGE_CENTRAL_ENABLED=true
# OTP_MESSAGE_CENTRAL_SMS_ENABLED=true
# OTP_MESSAGE_CENTRAL_WHATSAPP_ENABLED=false
# MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
# MESSAGE_CENTRAL_CUSTOMER_ID=C-xxxxxxxxxxxxxxxx
# MESSAGE_CENTRAL_AUTH_TOKEN=
# MESSAGE_CENTRAL_OTP_LENGTH=6
#
# Lebanon SMS OTP → UnoSMS (country +961 only). Other countries use Message Central above.
# OTP_UNOSMS_ENABLED=true
# UNOSMS_URL=https://sms.unosms.net/api.php
# UNOSMS_USER=
# UNOSMS_PASS=
# UNOSMS_FROM=Ehkini
# UNOSMS_TIMEOUT=15
# national = 71887115 (Lebanon, recommended) | international = 96171887115
# UNOSMS_PHONE_FORMAT=national
# OTP_UNOSMS_COUNTRY_CODES=961
